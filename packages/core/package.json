{
  "name": "@sentient-browser/core",
  "version": "0.1.1",
  "description": "Core runtime engine and CDP controller for Sentient Browser",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "license": "MIT",
  "author": {
    "name": "Chintan Vaghela",
    "url": "https://github.com/chintanvaghela"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chintanvaghela/sentient-browser.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/chintanvaghela/sentient-browser#readme",
  "bugs": {
    "url": "https://github.com/chintanvaghela/sentient-browser/issues"
  },
  "keywords": [
    "browser",
    "runtime",
    "ai",
    "cdp",
    "semantic-dom",
    "state-diff"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright-core": "^1.48.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13"
  }
}
