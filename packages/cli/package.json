{
  "name": "@sentient/cli",
  "version": "0.1.0",
  "description": "Command line interface and REPL for Sentient Browser",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "sentient": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sentient/core": "workspace:*",
    "@sentient/mcp": "workspace:*",
    "@sentient/sdk": "workspace:*",
    "commander": "^12.1.0"
  }
}
