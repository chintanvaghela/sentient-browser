{
  "name": "@sentient-browser/cli",
  "version": "0.1.1",
  "description": "Command line interface and REPL for Sentient Browser",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "sentient": "./dist/index.js"
  },
  "license": "MIT",
  "author": {
    "name": "Chintan Vaghela",
    "url": "https://github.com/chintanvaghela"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chintanvaghela/sentient-browser.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/chintanvaghela/sentient-browser#readme",
  "bugs": {
    "url": "https://github.com/chintanvaghela/sentient-browser/issues"
  },
  "keywords": [
    "browser",
    "cli",
    "ai",
    "agent",
    "terminal",
    "repl"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sentient-browser/core": "workspace:*",
    "@sentient-browser/mcp": "workspace:*",
    "@sentient-browser/sdk": "workspace:*",
    "commander": "^12.1.0"
  }
}
