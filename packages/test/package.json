{
  "name": "@sentient-browser/test",
  "version": "0.1.1",
  "description": "Test runner adapter and custom matchers for Playwright and Vitest",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "license": "MIT",
  "author": {
    "name": "Chintan Vaghela",
    "url": "https://github.com/chintanvaghela"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chintanvaghela/sentient-browser.git",
    "directory": "packages/test"
  },
  "homepage": "https://github.com/chintanvaghela/sentient-browser#readme",
  "bugs": {
    "url": "https://github.com/chintanvaghela/sentient-browser/issues"
  },
  "keywords": [
    "browser",
    "test",
    "playwright",
    "vitest",
    "testing",
    "adapter",
    "matchers"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sentient-browser/core": "workspace:*",
    "@sentient-browser/sdk": "workspace:*",
    "playwright-core": "^1.48.2"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0"
  }
}
