{
  "name": "sentient-browser",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "An AI-native browser runtime designed for autonomous AI agents",
  "author": {
    "name": "Chintan Vaghela",
    "url": "https://github.com/chintanvaghela"
  },
  "license": "MIT",
  "homepage": "https://github.com/chintanvaghela/sentient-browser#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chintanvaghela/sentient-browser.git"
  },
  "bugs": {
    "url": "https://github.com/chintanvaghela/sentient-browser/issues"
  },
  "keywords": [
    "browser",
    "ai",
    "agent",
    "cdp",
    "mcp",
    "model-context-protocol",
    "autonomous-agent",
    "semantic-dom",
    "playwright"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" run build",
