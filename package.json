    "test:watch": "vitest",
    "typecheck": "pnpm --filter \"./packages/*\" run typecheck"
  },
  "devDependencies": {
    "@sentient-browser/core": "workspace:*",
    "@sentient-browser/mcp": "workspace:*",
    "@sentient-browser/sdk": "workspace:*",
    "@types/node": "^22.8.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}

