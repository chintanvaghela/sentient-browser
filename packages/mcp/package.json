{
  "name": "@sentient-browser/mcp",
  "version": "0.1.1",
  "description": "Model Context Protocol (MCP) Server for Sentient Browser",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "sentient-mcp": "./dist/index.js"
  },
  "license": "MIT",
  "author": {
    "name": "Chintan Vaghela",
    "url": "https://github.com/chintanvaghela"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chintanvaghela/sentient-browser.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/chintanvaghela/sentient-browser#readme",
  "bugs": {
    "url": "https://github.com/chintanvaghela/sentient-browser/issues"
  },
  "keywords": [
    "browser",
    "mcp",
    "model-context-protocol",
    "ai",
    "agent",
    "claude",
    "cursor"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sentient-browser/core": "workspace:*",
    "@sentient-browser/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.4"
  }
}
